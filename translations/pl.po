#, python-brace-format
msgid ""
"The file \"{0}\" don't exist. Probably conversion to text format failed."
msgstr ""
"Plik {0} nie istnieje. Prawdopodobnie konwersja do formatu tekstowego nie "
"powiodła się."

#: main.py:1000 main.py:1001
msgid "Compare aborted."
msgstr "Porównanie przerwane."

#: main.py:1009 main.py:1010
msgid "Deleting temp file..."
msgstr "Usuwanie pliku tymczasowego..."

#: main.py:1014 main.py:1015
